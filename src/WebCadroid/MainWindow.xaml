<Window x:Class="WebCadroid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enums="clr-namespace:WebCadroid.Types.Enums"
        xmlns:local="clr-namespace:WebCadroid"
        Width="800"
        Height="450"
        AllowsTransparency="True"
        Background="Transparent"
        Title="WebCadroid"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
  <Border Background="#1E1E1E"
          BorderBrush="#333333"
          BorderThickness="1"
          CornerRadius="15">
    <Grid>
      <Grid.RowDefinitions>
        <!-- Top bar -->
        <RowDefinition Height="50" />
        <!-- Main content (Table) -->
        <RowDefinition Height="*" />
        <!-- Switch Bar -->
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- 1. Top bar -->
      <Grid Background="{x:Null}"
            Focusable="False"
            MouseDown="TitleBar_MouseDown"
            Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Margin="15,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"
                   Text="Web Cadroid" />
        <StackPanel Margin="0,0,10,0"
                    Orientation="Horizontal"
                    Grid.Column="1">
          <Button Content="—"
                  Click="MinimizeButton_Click"
                  Style="{StaticResource TitleBarBtnStyle}" />
          <Button Content="✕"
                  Click="CloseButton_Click"
                  Style="{StaticResource CloseBtnStyle}" />
        </StackPanel>
      </Grid>
      <!-- 2. Main content (DataGrid Table) -->
      <Border x:Name="DevicesGridBody"
              Width="660"
              Height="220"
              Margin="0,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="#FF303030"
              CornerRadius="18,18,18,18"
              Visibility="Visible"
              Grid.Column="0"
              Grid.Row="1">
        <DataGrid x:Name="DevicesDataGrid"
                  AutoGenerateColumns="False"
                  Background="Transparent"
                  BorderThickness="0"
                  CanUserAddRows="False"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  RowStyle="{StaticResource DeviceRowStyle}"
                  SelectionMode="Single">
          <!-- Table title style -->
          <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="#888888" />
              <Setter Property="FontWeight" Value="Bold" />
              <Setter Property="Padding" Value="15,10" />
              <Setter Property="BorderThickness" Value="0,0,0,2" />
              <Setter Property="BorderBrush" Value="#404040" />
            </Style>
          </DataGrid.ColumnHeaderStyle>
          <DataGrid.Columns>
            <!-- Device Name Column -->
            <DataGridTextColumn Width="*"
                                Binding="{Binding DeviceName}"
                                Header="Device Name" />
            <!-- Device ID Column -->
            <DataGridTextColumn Width="100"
                                Binding="{Binding DeviceId}"
                                Header="Device ID" />
            <!-- Stream status Column -->
            <DataGridTextColumn Width="100"
                                Binding="{Binding Status}"
                                Header="Stream" />
            <!-- Action Column (Connect Button on Hover) -->
            <DataGridTemplateColumn Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button x:Name="ConnectBtn"
                          Height="24"
                          Margin="0,0,5,0"
                          Click="ConnectButton_Click"
                          Cursor="Hand"
                          Visibility="Hidden">
                    <Button.Style>
                      <Style TargetType="Button">
                        <!-- По дефолту (NotOpened) -->
                        <Setter Property="Content" Value="Not opened" />
                        <Setter Property="Background" Value="#6c757d" />
                        <Setter Property="BorderBrush" Value="#ccc" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" >
                                  <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <!-- Доступен для подключения (Available) -->
                          <DataTrigger Binding="{Binding Status}"
                                       Value="{x:Static enums:StreamStatus.Available}">
                            <Setter Property="Content" Value="Connect" />
                            <Setter Property="Background" Value="#28a745" />
                            <Setter Property="BorderBrush" Value="#8fc99c" />
                            <!-- Зеленый -->
                            <Setter Property="IsEnabled" Value="True" />
                          </DataTrigger>
                          <!-- Активен (Streaming) -->
                          <DataTrigger Binding="{Binding Status}"
                                       Value="{x:Static enums:StreamStatus.Streaming}">
                            <Setter Property="Content" Value="Disconnect" />
                            <Setter Property="Background" Value="#dc3545" />
                            <Setter Property="BorderBrush" Value="#d6a9ae" />
                            <!-- Красный -->
                            <Setter Property="IsEnabled" Value="True" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <!-- Button showing logic -->
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}"
                                 Value="True">
                      <Setter Property="Visibility"
                              TargetName="ConnectBtn"
                              Value="Visible" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Grid x:Name="PreviewContainer"
            Width="NaN"
            Visibility="Collapsed"
            Grid.Row="1">
        <Border x:Name="NoStreamBorder"
                Width="495"
                Height="277"
                Background="#2D2D30"
                CornerRadius="16"
                Visibility="Visible">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="18"
                     Foreground="Gray"
                     Text="Stream is not opened" />
        </Border>
          <Border x:Name="StreamImageContainer"
                  Width="495"
                  Height="277"
                  CornerRadius="16"
                  ClipToBounds="True"
                  Visibility="Collapsed">
            <Grid>
              <Image x:Name="StreamImage"
                    Stretch="UniformToFill"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Image.Clip>
                    <RectangleGeometry Rect="0,0,495,277" 
                                      RadiusX="16" 
                                      RadiusY="16" />
                </Image.Clip>
              </Image>
              <Border x:Name="PreviewPausedOverlay"
                      Background="#D9181818"
                      CornerRadius="16"
                      Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock HorizontalAlignment="Center"
                             FontSize="16"
                             FontWeight="Bold"
                             Foreground="White"
                             Text="Preview Paused" />
                  <TextBlock HorizontalAlignment="Center"
                             Margin="0,6,0,0"
                             FontSize="12"
                             Foreground="#888888"
                             Text="Virtual camera continues streaming" />
                </StackPanel>
              </Border>
              <Button x:Name="TogglePreviewBtn"
                      Content="Pause Preview"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,12,12"
                      Padding="10,5"
                      Cursor="Hand"
                      Click="TogglePreviewButton_Click">
                <Button.Style>
                  <Style TargetType="Button">
                      <Setter Property="Background" Value="#80000000" />
                      <Setter Property="BorderBrush" Value="#40ffffff" />
                      <Setter Property="Foreground" Value="White" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Button">
                            <Border CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" >
                                <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                  </Style>
                </Button.Style>
              </Button>
            </Grid>
          </Border>
      </Grid>
      <!-- 3. Switch bar -->
      <Grid Margin="0,0,0,60"
            Background="{x:Null}"
            Focusable="False"
            Grid.Row="2">
        <!-- Switch bar layout -->
        <Border HorizontalAlignment="Center"
                Background="#181818"
                BorderBrush="#0A3A60"
                BorderThickness="1"
                CornerRadius="18"
                Padding="3"
                Grid.Column="1">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="DevicesTabRadio"
                         Content="DEVICES"
                         Checked="SwitchMode_Checked"
                         GroupName="ModeSwitch"
                         IsChecked="True"
                         Style="{StaticResource SegmentedRadioButton}" />
            <RadioButton x:Name="PreviewTabRadio"
                         Content="CAMERA PREVIEW"
                         Checked="SwitchMode_Checked"
                         GroupName="ModeSwitch"
                         Style="{StaticResource SegmentedRadioButton}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>