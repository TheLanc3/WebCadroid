<Window x:Class="WebCadroid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WebCadroid"
        xmlns:enums="clr-namespace:WebCadroid.Types.Enums"
        Width="800"
        Height="450"
        AllowsTransparency="True"
        Background="Transparent"
        Title="WebCadroid"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
  <Border Background="#1E1E1E"
          BorderBrush="#333333"
          BorderThickness="1"
          CornerRadius="15">
    <Grid>
      <Grid.RowDefinitions>
        <!-- Top bar -->
        <RowDefinition Height="50" />
        <!-- Main content (Table) -->
        <RowDefinition Height="*" />
        <!-- Switch Bar -->
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- 1. Top bar -->
      <Grid Background="{x:Null}"
            Focusable="False"
            MouseDown="TitleBar_MouseDown"
            Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Margin="15,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"
                   Text="Web Cadroid" />
        <StackPanel Margin="0,0,10,0"
                    Orientation="Horizontal"
                    Grid.Column="1">
          <Button Content="—"
                  Click="MinimizeButton_Click"
                  Style="{StaticResource TitleBarBtnStyle}" />
          <Button Content="✕"
                  Click="CloseButton_Click"
                  Style="{StaticResource CloseBtnStyle}" />
        </StackPanel>
      </Grid>
      <!-- 2. Main content (DataGrid Table) -->
      <Border Width="660"
              Height="220"
              Margin="0,0,0,0"
              Visibility="Visible"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="#FF303030"
              CornerRadius="18,18,18,18"
              Grid.Column="0"
              Grid.Row="1">
        <DataGrid x:Name="DevicesDataGrid"
                  AutoGenerateColumns="False"
                  Background="Transparent"
                  BorderThickness="0"
                  CanUserAddRows="False"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  RowStyle="{StaticResource DeviceRowStyle}"
                  SelectionMode="Single">
          <!-- Table title style -->
          <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="#888888" />
              <Setter Property="FontWeight" Value="Bold" />
              <Setter Property="Padding" Value="15,10" />
              <Setter Property="BorderThickness" Value="0,0,0,2" />
              <Setter Property="BorderBrush" Value="#404040" />
            </Style>
          </DataGrid.ColumnHeaderStyle>
          <DataGrid.Columns>
            <!-- Device Name Column -->
            <DataGridTextColumn Width="*"
                                Binding="{Binding DeviceName}"
                                Header="Device Name" />
            <!-- Device ID Column -->
            <DataGridTextColumn Width="100"
                                Binding="{Binding DeviceId}"
                                Header="Device ID" />
            <!-- Stream status Column -->
            <DataGridTextColumn Width="100"
                                Binding="{Binding Status}"
                                Header="Stream" />
            <!-- Action Column (Connect Button on Hover) -->
            <DataGridTemplateColumn Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button x:Name="ConnectBtn"
                          Content="Connect"
                          Height="24" 
                          Margin="0,0,5,0"
                          Click="ConnectButton_Click"
                          Cursor="Hand"
                          Visibility="Hidden">
                    <Button.Style>
                      <Style TargetType="Button">
                          <!-- По дефолту (NotOpened) -->
                          <Setter Property="Content" Value="Connect"/>
                          <Setter Property="Background" Value="#6c757d"/>
                          <Setter Property="Foreground" Value="White"/>
                          <Setter Property="IsEnabled" Value="False"/>

                          <Style.Triggers>
                              <!-- Доступен для подключения (Available) -->
                              <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StreamStatus.Available}">
                                  <Setter Property="Content" Value="Connect"/>
                                  <Setter Property="Background" Value="#28a745"/> <!-- Зеленый -->
                                  <Setter Property="IsEnabled" Value="True"/>
                              </DataTrigger>

                              <!-- Активен (Streaming) -->
                              <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StreamStatus.Streaming}">
                                  <Setter Property="Content" Value="Disconnect"/>
                                  <Setter Property="Background" Value="#dc3545"/> <!-- Красный -->
                                  <Setter Property="IsEnabled" Value="True"/>
                              </DataTrigger>
                          </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <!-- Button showing logic -->
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}"
                                 Value="True">
                      <Setter Property="Visibility"
                              TargetName="ConnectBtn"
                              Value="Visible" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Grid x:Name="PreviewContainer"
            Visibility="Collapsed"
            Grid.Row="1">
                
        <Border x:Name="NoStreamBorder" Background="#2D2D30" CornerRadius="16" Visibility="Visible">
            <TextBlock Text="Stream is not opened" Foreground="Gray" 
                        FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Image x:Name="StreamImage" Stretch="Uniform" Visibility="Collapsed"/>
      </Grid>
      <!-- 3. Switch bar -->
      <Grid Margin="0,0,0,60"
            Background="{x:Null}"
            Focusable="False"
            Grid.Row="2">
        <!-- Switch bar layout -->
        <Border HorizontalAlignment="Center"
                Background="#181818"
                BorderBrush="#0A3A60"
                BorderThickness="1"
                CornerRadius="18"
                Padding="3"
                Grid.Column="1">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="DevicesTabRadio"
                         Content="DEVICES"
                         Checked="SwitchMode_Checked"
                         GroupName="ModeSwitch"
                         IsChecked="True"
                         Style="{StaticResource SegmentedRadioButton}" />
            <RadioButton x:Name="PreviewTabRadio"
                         Content="CAMERA PREVIEW"
                         Checked="SwitchMode_Checked"
                         GroupName="ModeSwitch"
                         Style="{StaticResource SegmentedRadioButton}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>