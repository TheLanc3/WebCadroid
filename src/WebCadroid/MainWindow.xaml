<Window x:Class="WebCadroid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WebCadroid"
        Width="800"
        Height="450"
        AllowsTransparency="True"
        Background="Transparent"
        Title="WebCadroid"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
  <Border Background="#1E1E1E"
          BorderBrush="#333333"
          BorderThickness="1"
          CornerRadius="15">
    <Grid>
      <Grid.RowDefinitions>
        <!-- Top bar -->
        <RowDefinition Height="50" />
        <!-- Main content -->
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!-- 1. Top bar -->
      <Grid Background="{x:Null}"
            Focusable="False"
            MouseDown="TitleBar_MouseDown"
            Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Margin="15,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"
                   Text="Web Cadroid" />
        <StackPanel Margin="0,0,10,0"
                    Orientation="Horizontal"
                    Grid.Column="1">
          <Button Content="—"
                  Click="MinimizeButton_Click"
                  Style="{StaticResource TitleBarBtnStyle}" />
          <Button Content="✕"
                  Click="CloseButton_Click"
                  Style="{StaticResource CloseBtnStyle}" />
        </StackPanel>
      </Grid>
      <!-- 2. Main content -->
      <Grid Margin="20" Grid.Row="1">
        <Border Width="660"
                Height="220"
                Margin="0,0,0,60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FF303030"
                CornerRadius="18,18,18,18"
                Grid.Column="0"
                Grid.Row="0" />
        <!-- 2.1 Table content -->
        <Grid>
          <Grid.RowDefinitions>
            <!-- Table top bar -->
            <RowDefinition Height="50" />
            <!-- Table content -->
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
        </Grid>
      </Grid>
      <!-- 3. Switch button -->
      <Grid Margin="20" Grid.Row="2">
        <StackPanel Margin="0,0,10,0"
                    Orientation="Horizontal"
                    Grid.Column="1">
          <Button Content="Devices"
                  Click="MinimizeButton_Click" />
          <Button Content="Camera preview"
                  Click="CloseButton_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>